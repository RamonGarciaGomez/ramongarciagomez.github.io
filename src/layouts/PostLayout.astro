---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  /** Catalog ID e.g. E-001 or P-001. Rendered as the eyebrow. */
  catalog?: string;
  /** Section label — "Writing" for blog, "Projects" for projects. */
  section?: string;
  /** For project pages: status badge. */
  status?: string;
}
const {
  title,
  description,
  date,
  tags = [],
  catalog,
  section = "Writing",
  status,
} = Astro.props;

const dateStr = date
  .toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  })
  .toUpperCase();

const statusClass: Record<string, string> = {
  active: "text-[color:var(--color-accent)]",
  shipped: "text-[#2d7a4f]",
  archived: "text-[color:var(--color-muted)]",
};
---
<BaseLayout title={title} description={description}>

  <!-- Eyebrow: section · catalog id · date -->
  <div class="pt-2 pb-6 mono text-xs uppercase tracking-widest text-[color:var(--color-muted)] flex flex-wrap gap-x-3 gap-y-1">
    <a href={section === "Writing" ? "/blog" : "/projects"} class="hover:text-[color:var(--color-accent)] transition-colors">
      The Record · {section}
    </a>
    {catalog && <><span aria-hidden="true">·</span><span>{catalog}</span></>}
    <span aria-hidden="true">·</span>
    <span>{dateStr}</span>
    {status && (
      <>
        <span aria-hidden="true">·</span>
        <span class:list={[statusClass[status] ?? "text-[color:var(--color-muted)]"]}>
          [{status}]
        </span>
      </>
    )}
  </div>

  <!-- Title -->
  <h1 class="display text-4xl md:text-6xl mb-5 max-w-4xl">{title}</h1>

  {description && (
    <p class="font-serif italic text-xl md:text-2xl text-[color:var(--color-muted)] max-w-2xl leading-snug mb-10">
      {description}
    </p>
  )}

  {tags.length > 0 && (
    <ul class="flex flex-wrap gap-x-3 gap-y-1 mono text-[0.7rem] uppercase tracking-widest text-[color:var(--color-muted)] mb-10">
      {tags.map((t) => <li>#{t}</li>)}
    </ul>
  )}

  <!-- Full-bleed divider before body -->
  <div class="border-t border-[color:var(--color-rule)] mb-10"></div>

  <!-- Body -->
  <article class="prose-post mx-0">
    <slot />
  </article>

  <!-- Back link -->
  <div class="mt-20 pt-8 border-t border-[color:var(--color-rule)]">
    <a
      href={section === "Writing" ? "/blog" : "/projects"}
      class="mono text-xs uppercase tracking-widest text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] transition-colors"
    >
      ← Back to {section.toLowerCase()}
    </a>
  </div>

</BaseLayout>
