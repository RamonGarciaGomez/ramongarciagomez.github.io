---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
}
const { title, description, date, tags = [] } = Astro.props;
const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---
<BaseLayout title={title} description={description}>
  <article class="prose-post mx-auto">
    <header class="mb-8 not-prose">
      <p class="text-sm text-[color:var(--color-muted)] font-sans">{dateStr}</p>
      <h1 class="font-sans text-3xl md:text-4xl font-semibold tracking-tight mt-2">{title}</h1>
      {description && <p class="mt-3 text-[color:var(--color-muted)] font-sans">{description}</p>}
      {tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2 font-sans text-xs text-[color:var(--color-muted)]">
          {tags.map((t) => <li>#{t}</li>)}
        </ul>
      )}
    </header>
    <slot />
  </article>
</BaseLayout>
