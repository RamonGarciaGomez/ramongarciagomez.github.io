---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { NOW } from "../config";

// Pull everything
const rawPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf()); // ASC for numbering
const rawProjects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

// Assign sequential catalog IDs within type. Oldest = 001.
const pad = (n: number) => String(n).padStart(3, "0");
const posts = rawPosts.map((p, i) => ({
  ...p,
  kind: "post" as const,
  catalog: `E-${pad(i + 1)}`,
}));
const projects = rawProjects.map((p, i) => ({
  ...p,
  kind: "project" as const,
  catalog: `P-${pad(i + 1)}`,
}));

// Combine, sort DESC for display
const entries = [...posts, ...projects].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const totalCount = entries.length;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  }).toUpperCase();

// For the "Est." line
const oldest = entries.length
  ? entries[entries.length - 1].data.date
  : new Date();
const establishedMonth = oldest.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
---

<BaseLayout>

  <!-- ░░ HERO ░░ -->
  <section class="pt-4 md:pt-8 pb-14 md:pb-20">
    <p class="eyebrow mb-6">The Record — Issue No. {pad(totalCount)}</p>

    <h1 class="display text-6xl md:text-8xl lg:text-9xl mb-8">
      Ramon<br />García-Gómez
    </h1>

    <p class="font-serif italic text-xl md:text-2xl text-[color:var(--color-ink)] max-w-xl leading-snug mb-6">
      Writer, builder, and student of most things. Keeping a public record of what
      I make, read, and think about.
    </p>

    <div class="flex flex-wrap gap-x-5 gap-y-1 mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">
      <span>→ {totalCount} {totalCount === 1 ? "entry" : "entries"}</span>
      <span aria-hidden="true">·</span>
      <span>{NOW.location}</span>
      <span aria-hidden="true">·</span>
      <span>Est. {establishedMonth}</span>
    </div>
  </section>

  <!-- ░░ MASTHEAD RULE ░░ -->
  <div class="border-t-2 border-[color:var(--color-ink)]"></div>
  <div class="border-t border-[color:var(--color-ink)] mt-[2px]"></div>

  <!-- ░░ ENTRIES ░░ -->
  <section class="pt-10">

    <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
      <h2 class="eyebrow">Entries</h2>
      <div class="flex gap-0 border border-[color:var(--color-rule)]" id="filter-buttons" role="group" aria-label="Filter entries">
        {[
          { id: "all",     label: "All"      },
          { id: "post",    label: "Writing"  },
          { id: "project", label: "Projects" },
        ].map(({ id, label }, i) => (
          <button
            data-filter={id}
            class:list={[
              "filter-btn mono text-[0.7rem] uppercase tracking-widest px-3 py-1.5 transition-colors cursor-pointer",
              i > 0 && "border-l border-[color:var(--color-rule)]",
              id === "all"
                ? "bg-[color:var(--color-ink)] text-[color:var(--color-paper)]"
                : "text-[color:var(--color-muted)] hover:text-[color:var(--color-ink)] hover:bg-[color:var(--color-rule)]/40",
            ]}
          >
            {label}
          </button>
        ))}
      </div>
    </div>

    <ul id="recent-list" class="border-t border-[color:var(--color-rule)]">
      {entries.map((item) => (
        <li data-kind={item.kind} class="border-b border-[color:var(--color-rule)]">
          <a
            href={item.kind === "post" ? `/blog/${item.id}` : `/projects/${item.id}`}
            class="group grid grid-cols-[auto_1fr] md:grid-cols-[auto_1fr_auto] gap-x-4 md:gap-x-8 gap-y-1 py-5 md:py-6 items-baseline"
          >
            <!-- catalog id -->
            <span class="mono text-xs text-[color:var(--color-muted)] group-hover:text-[color:var(--color-accent)] transition-colors shrink-0">
              {item.catalog}
            </span>

            <!-- title + description -->
            <div class="col-start-2 min-w-0">
              <h3 class="font-serif text-xl md:text-2xl leading-tight group-hover:underline decoration-1 underline-offset-[5px] decoration-[color:var(--color-accent)]">
                {item.data.title}
              </h3>
              {item.data.description && (
                <p class="mt-1 text-[color:var(--color-muted)] text-sm md:text-base leading-relaxed">
                  {item.data.description}
                </p>
              )}
            </div>

            <!-- date -->
            <span class="col-start-2 md:col-start-3 mono text-xs text-[color:var(--color-muted)] tracking-widest shrink-0 md:text-right">
              {fmt(item.data.date)}
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap gap-6 mono text-xs uppercase tracking-widest">
      <a href="/blog" class="hover:text-[color:var(--color-accent)] transition-colors">
        → All writing
      </a>
      <a href="/projects" class="hover:text-[color:var(--color-accent)] transition-colors">
        → All projects
      </a>
    </div>
  </section>

  <!-- ░░ READING + LOCATION FOOTNOTE ░░ -->
  <section class="mt-20 pt-8 border-t border-[color:var(--color-rule)]">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div>
        <p class="eyebrow mb-2">Desk</p>
        <p class="font-serif text-base">{NOW.location}</p>
      </div>
      <div>
        <p class="eyebrow mb-2">Reading</p>
        {NOW.book.url ? (
          <a
            href={NOW.book.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-serif text-base italic hover:text-[color:var(--color-accent)] transition-colors"
          >
            {NOW.book.title}
            <span class="not-italic text-[color:var(--color-muted)]"> — {NOW.book.author}</span>
          </a>
        ) : (
          <p class="font-serif text-base italic">
            {NOW.book.title}
            <span class="not-italic text-[color:var(--color-muted)]"> — {NOW.book.author}</span>
          </p>
        )}
      </div>
      <div>
        <p class="eyebrow mb-2">Moving</p>
        {NOW.strava.weeklyKm ? (
          <p class="font-serif text-base">
            {NOW.strava.weeklyKm} km this week
          </p>
        ) : (
          <p class="font-serif text-base text-[color:var(--color-muted)] italic">
            Strava integration coming soon
          </p>
        )}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLLIElement>("#recent-list li");

  const activeClasses = ["bg-[color:var(--color-ink)]", "text-[color:var(--color-paper)]"];
  const inactiveClasses = ["text-[color:var(--color-muted)]"];

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter!;
      buttons.forEach((b) => {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      });
      btn.classList.remove(...inactiveClasses);
      btn.classList.add(...activeClasses);
      items.forEach((item) => {
        const match = filter === "all" || item.dataset.kind === filter;
        (item as HTMLElement).style.display = match ? "" : "none";
      });
    });
  });
</script>
