---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getStravaData } from "../lib/strava";
import RouteSvg from "../components/RouteSvg.astro";
import BikeSoloist from "../components/BikeSoloist.astro";
import BikeBayWheels from "../components/BikeBayWheels.astro";

const strava = await getStravaData();

function relativeTime(iso: string): string {
  const diff = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return "just now";
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  return `${Math.floor(hrs / 24)}d ago`;
}
---
<BaseLayout title="Movement" description="Strava stats — weekly totals, year to date, and recent activities.">

  <!-- ░░ HEADER ░░ -->
  <header class="pt-4 pb-12 md:pb-16">
    <p class="eyebrow mb-5">Movement</p>
    <h1 class="display text-5xl md:text-7xl mb-6">Movement</h1>
    <p class="mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">
      {strava.status === "ok"
        ? `Live stats from Strava · Synced ${relativeTime(strava.syncedAt)}`
        : "Stats from Strava"}
    </p>
  </header>

  <div class="border-t-2 border-[color:var(--color-ink)]"></div>
  <div class="border-t border-[color:var(--color-ink)] mt-[2px]"></div>

  {strava.status === "error" ? (

    <!-- ░░ ERROR STATE ░░ -->
    <div class="pt-20 pb-32 text-center">
      <p class="mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">
        Strava data unavailable · Try again soon
      </p>
    </div>

  ) : (

    <div class="pt-10 space-y-20">

      <!-- ░░ THIS WEEK ░░ -->
      <section>
        <p class="eyebrow mb-8">This week</p>
        <div class="flex items-baseline gap-4 mb-4">
          <span class="stat-num text-7xl md:text-[11rem]">{strava.thisWeek.mi}</span>
          <span class="mono text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)] self-end pb-4 md:pb-8">miles</span>
        </div>
        <p class="mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-muted)]">
          {strava.thisWeek.count} {strava.thisWeek.count === 1 ? "activity" : "activities"}
          {strava.thisWeek.count > 0 && (
            <span> &nbsp;·&nbsp; {strava.thisWeek.duration_fmt} total</span>
          )}
        </p>
      </section>

      <!-- ░░ YEAR TO DATE ░░ -->
      <section>
        <p class="eyebrow mb-8">Year to date</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-6 border-t border-[color:var(--color-rule)] pt-8">
          {[
            { label: "Running", value: strava.ytd.run.mi, unit: "miles", count: strava.ytd.run.count, countLabel: "runs" },
            { label: "Cycling", value: strava.ytd.ride.mi, unit: "miles", count: strava.ytd.ride.count, countLabel: "rides" },
            { label: "Weight training", value: strava.ytd.weights.hours, unit: "hours", count: strava.ytd.weights.count, countLabel: "sessions" },
          ].map(({ label, value, unit, count, countLabel }) => (
            <div>
              <p class="eyebrow mb-3 text-[0.65rem]">{label}</p>
              <div class="flex items-baseline gap-2 mb-2">
                <span class="stat-num text-5xl md:text-6xl">{value}</span>
                <span class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)]">{unit}</span>
              </div>
              <p class="mono text-xs text-[color:var(--color-muted)]">
                {count} {countLabel}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- ░░ MONTHLY MILES ░░ -->
      {strava.monthly.length > 0 && (() => {
        const thisYear  = new Date().getUTCFullYear();
        const lastYear  = thisYear - 1;
        const data      = strava.monthly;
        const hasLastYr = data.some(d => d.mi_last_year > 0);

        // SVG chart constants
        const W = 800, H = 180;
        const MT = 16, MR = 16, MB = 40, ML = 16;
        const innerW = W - ML - MR;
        const innerH = H - MT - MB;

        const maxMi = Math.max(...data.flatMap(d => [d.mi_this_year, d.mi_last_year]), 1);
        const maxScale = Math.ceil(maxMi / 5) * 5;  // round up to nearest 5

        const nGroups  = data.length;
        const groupW   = innerW / nGroups;
        const barW     = Math.max(1, Math.min(28, (groupW - 6) / (hasLastYr ? 2 : 1)));
        const barGap   = 3;

        function bH(mi: number) { return (mi / maxScale) * innerH; }
        function bY(mi: number) { return MT + innerH - bH(mi); }

        return (
          <section>
            <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
              <p class="eyebrow">Monthly miles</p>
              <div class="flex items-center gap-4 mono text-[0.65rem] uppercase tracking-[0.18em] text-[color:var(--color-muted)]">
                <span class="flex items-center gap-1.5">
                  <span class="inline-block w-3 h-3 bg-[color:var(--color-ink)]"></span>{thisYear}
                </span>
                {hasLastYr && (
                  <span class="flex items-center gap-1.5">
                    <span class="inline-block w-3 h-3 bg-[color:var(--color-rule)]"></span>{lastYear}
                  </span>
                )}
              </div>
            </div>
            <svg
              viewBox={`0 0 ${W} ${H}`}
              class="w-full border-b border-[color:var(--color-rule)]"
              aria-label="Monthly miles chart"
              role="img"
            >
              {/* Y-axis max label */}
              <text
                x={ML}
                y={MT - 4}
                font-family="ui-monospace,monospace"
                font-size="10"
                fill="var(--color-muted)"
                text-anchor="start"
              >{maxScale} mi</text>

              {/* Gridline at top */}
              <line
                x1={ML} y1={MT}
                x2={W - MR} y2={MT}
                stroke="var(--color-rule)"
                stroke-width="0.5"
              />

              {/* Bars */}
              {data.map((d, i) => {
                const gx = ML + i * groupW;
                const cx = gx + groupW / 2;

                const thisBarW  = barW;
                const lastBarW  = hasLastYr ? barW : 0;
                const totalBarsW = thisBarW + (hasLastYr ? lastBarW + barGap : 0);
                const barsLeft  = cx - totalBarsW / 2;

                const thisH = bH(d.mi_this_year);
                const lastH = hasLastYr ? bH(d.mi_last_year) : 0;

                return (
                  <>
                    {/* Last year bar (behind) */}
                    {hasLastYr && lastH > 0 && (
                      <rect
                        x={barsLeft + thisBarW + barGap}
                        y={bY(d.mi_last_year)}
                        width={lastBarW}
                        height={lastH}
                        fill="var(--color-rule)"
                      />
                    )}
                    {/* This year bar */}
                    {thisH > 0 && (
                      <rect
                        x={barsLeft}
                        y={bY(d.mi_this_year)}
                        width={thisBarW}
                        height={thisH}
                        fill="var(--color-ink)"
                      />
                    )}
                    {/* Month label */}
                    <text
                      x={cx}
                      y={H - 8}
                      font-family="ui-monospace,monospace"
                      font-size="10"
                      fill="var(--color-muted)"
                      text-anchor="middle"
                    >{d.month}</text>
                  </>
                );
              })}
            </svg>
          </section>
        );
      })()}

      <!-- ░░ LATEST ACTIVITY ░░ -->
      {strava.latest && (
        <section>
          <p class="eyebrow mb-6">Latest</p>
          <p class="mono text-xs uppercase tracking-widest text-[color:var(--color-muted)] mb-3">
            {strava.latest.sport_type} · {strava.latest.date_fmt} · {strava.latest.catalog}
            {strava.latest.gear_name && (
              <span> · {strava.latest.gear_name}</span>
            )}
          </p>
          <h2 class="display text-4xl md:text-6xl mb-8 leading-tight">
            {strava.latest.name}
          </h2>

          <!-- Route -->
          <div class="mb-8">
            {strava.latest.polyline ? (
              <div class="text-[color:var(--color-accent)]">
                <RouteSvg polyline={strava.latest.polyline} width={480} height={220} stroke={2} class="w-full h-auto max-w-xl" />
              </div>
            ) : (
              <div class="mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">
                No route data for this activity
              </div>
            )}
          </div>

          <!-- Stats grid -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 border-t border-[color:var(--color-rule)] pt-6">
            <div>
              <p class="eyebrow mb-2 text-[0.65rem]">Distance</p>
              <p class="stat-num text-3xl">{strava.latest.distance_mi}<span class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)] ml-1.5">mi</span></p>
            </div>
            {strava.latest.pace_fmt && (
              <div>
                <p class="eyebrow mb-2 text-[0.65rem]">Pace</p>
                <p class="stat-num text-3xl">{strava.latest.pace_fmt}</p>
              </div>
            )}
            <div>
              <p class="eyebrow mb-2 text-[0.65rem]">Duration</p>
              <p class="stat-num text-3xl">{strava.latest.moving_time_fmt}</p>
            </div>
            <div>
              <p class="eyebrow mb-2 text-[0.65rem]">Elevation</p>
              <p class="stat-num text-3xl">{strava.latest.elevation_ft}<span class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)] ml-1.5">ft</span></p>
            </div>
          </div>

          <a
            href={strava.latest.strava_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-6 mono text-xs uppercase tracking-widest hover:text-[color:var(--color-accent)] transition-colors"
          >
            → View on Strava
          </a>
        </section>
      )}

      <!-- ░░ GEAR ░░ -->
      <section>
        <p class="eyebrow mb-8">Gear</p>

        {/* Cervélo Soloist — show when registered in Strava */}
        {(() => {
          const soloist = strava.bikes.find(b => /soloist/i.test(b.name));
          return soloist ? (
            <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-8 md:gap-12 items-center border-t border-[color:var(--color-rule)] pt-8 pb-10">
              <div><BikeSoloist /></div>
              <div>
                <p class="mono text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)] mb-2">Road bike · 2025</p>
                <h3 class="display text-3xl md:text-4xl mb-4">Cervélo Soloist</h3>
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm max-w-md mb-6">
                  <dt class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)] pt-1">Frame</dt>
                  <dd class="font-serif">Full carbon, truncated aero tubes</dd>
                  <dt class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)] pt-1">Groupset</dt>
                  <dd class="font-serif">SRAM Force eTap AXS</dd>
                  <dt class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)] pt-1">Signature</dt>
                  <dd class="font-serif italic">Dropped seat stays, integrated cockpit</dd>
                </dl>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-[color:var(--color-rule)] pt-4">
                  <div>
                    <p class="eyebrow text-[0.6rem] mb-1">This year</p>
                    <p class="stat-num text-2xl">{soloist.ytd_mi}<span class="mono text-[0.6rem] uppercase tracking-widest text-[color:var(--color-muted)] ml-1">mi</span></p>
                  </div>
                  <div>
                    <p class="eyebrow text-[0.6rem] mb-1">Rides</p>
                    <p class="stat-num text-2xl">{soloist.ytd_rides}</p>
                  </div>
                  <div>
                    <p class="eyebrow text-[0.6rem] mb-1">Elev · YTD</p>
                    <p class="stat-num text-2xl">{soloist.ytd_elev_ft}<span class="mono text-[0.6rem] uppercase tracking-widest text-[color:var(--color-muted)] ml-1">ft</span></p>
                  </div>
                  <div>
                    <p class="eyebrow text-[0.6rem] mb-1">All time</p>
                    <p class="stat-num text-2xl">{soloist.all_time_mi}<span class="mono text-[0.6rem] uppercase tracking-widest text-[color:var(--color-muted)] ml-1">mi</span></p>
                  </div>
                </div>
              </div>
            </div>
          ) : null;
        })()}

        {/* Bay Wheels — always shown */}
        {(() => {
          const bay = strava.bikes.find(b => /bay.?wheels|lyft/i.test(b.name));
          return (
            <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-8 md:gap-12 items-center border-t border-[color:var(--color-rule)] pt-8 pb-2">
              <div><BikeBayWheels /></div>
              <div>
                <p class="mono text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)] mb-2">City bike · Lyft</p>
                <h3 class="display text-3xl md:text-4xl mb-4">Bay Wheels Classic</h3>
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm max-w-md mb-6">
                  <dt class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)] pt-1">Frame</dt>
                  <dd class="font-serif">Step-through aluminum, colorful wrap</dd>
                  <dt class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)] pt-1">Drivetrain</dt>
                  <dd class="font-serif">Internal 3-speed, belt drive</dd>
                  <dt class="mono text-[0.65rem] uppercase tracking-[0.2em] text-[color:var(--color-muted)] pt-1">Role</dt>
                  <dd class="font-serif italic">Daily SF commute + errands</dd>
                </dl>
                {bay && (
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-[color:var(--color-rule)] pt-4">
                    <div>
                      <p class="eyebrow text-[0.6rem] mb-1">This year</p>
                      <p class="stat-num text-2xl">{bay.ytd_mi}<span class="mono text-[0.6rem] uppercase tracking-widest text-[color:var(--color-muted)] ml-1">mi</span></p>
                    </div>
                    <div>
                      <p class="eyebrow text-[0.6rem] mb-1">Rides</p>
                      <p class="stat-num text-2xl">{bay.ytd_rides}</p>
                    </div>
                    <div>
                      <p class="eyebrow text-[0.6rem] mb-1">Elev · YTD</p>
                      <p class="stat-num text-2xl">{bay.ytd_elev_ft}<span class="mono text-[0.6rem] uppercase tracking-widest text-[color:var(--color-muted)] ml-1">ft</span></p>
                    </div>
                    <div>
                      <p class="eyebrow text-[0.6rem] mb-1">All time</p>
                      <p class="stat-num text-2xl">{bay.all_time_mi}<span class="mono text-[0.6rem] uppercase tracking-widest text-[color:var(--color-muted)] ml-1">mi</span></p>
                    </div>
                  </div>
                )}
              </div>
            </div>
          );
        })()}
      </section>

      <!-- ░░ RECENT ACTIVITIES ░░ -->
      {strava.recent.length > 0 && (
        <section>
          <p class="eyebrow mb-6">Recent</p>
          <ul class="border-t border-[color:var(--color-rule)]">
            {strava.recent.map((activity) => (
              <li class="border-b border-[color:var(--color-rule)]">
                <a
                  href={activity.strava_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group grid grid-cols-[auto_1fr_auto_auto] gap-x-3 md:gap-x-6 gap-y-1 py-4 md:py-5 items-center"
                >
                  <span class="mono text-xs text-[color:var(--color-muted)] group-hover:text-[color:var(--color-accent)] transition-colors shrink-0 self-start mt-1">
                    {activity.catalog}
                  </span>
                  <div class="col-start-2 min-w-0">
                    <h3 class="font-serif text-lg md:text-xl leading-tight group-hover:underline decoration-1 underline-offset-[5px] decoration-[color:var(--color-accent)]">
                      {activity.name}
                    </h3>
                    <p class="mono text-xs text-[color:var(--color-muted)] mt-0.5">
                      {activity.sport_type} · {activity.distance_mi} mi
                      {activity.pace_fmt && <span> · {activity.pace_fmt}</span>}
                      {activity.is_ride && activity.gear_name && (
                        <span> · {activity.gear_name}</span>
                      )}
                    </p>
                  </div>
                  <span class="col-start-3 text-[color:var(--color-accent)] shrink-0">
                    {activity.polyline && (
                      <RouteSvg polyline={activity.polyline} width={80} height={34} stroke={1.2} class="sm:w-[120px] sm:h-[40px]" />
                    )}
                  </span>
                  <span class="col-start-4 mono text-xs text-[color:var(--color-muted)] tracking-widest shrink-0 text-right self-start mt-1">
                    {activity.date_fmt}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- ░░ FOOTER NOTE ░░ -->
      <p class="mono text-xs text-[color:var(--color-muted)] pb-4">
        Stats fetched at build time. Site rebuilds hourly.
      </p>

    </div>

  )}

</BaseLayout>
