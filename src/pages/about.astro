---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, NOW } from "../config";
---
<BaseLayout title="About" description="About Ramón Garcia Gomez and this site.">

  <header class="pt-4 pb-12 md:pb-16">
    <p class="eyebrow mb-5">Colophon</p>
    <h1 class="display text-5xl md:text-7xl mb-6">About</h1>
    <p class="mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">
      Who, what, and how this site is made
    </p>
  </header>

  <div class="border-t-2 border-[color:var(--color-ink)]"></div>
  <div class="border-t border-[color:var(--color-ink)] mt-[2px]"></div>

  <article class="prose-post pt-12 mx-0">
    <p class="!text-xl italic !mt-0">
      I'm Ramón Garcia Gomez. This is my public record — a permanent home for
      the writing, projects, and experiments that would otherwise live in feeds,
      DMs, and forgotten repos.
    </p>

    <p>
      I'm an avid Strava user and a relatively new developer, so a lot of what
      shows up here is me learning in public: things I figured out, things that
      broke, and the occasional interactive piece when a topic calls for one.
    </p>

    <p>
      I think about the web the way I think about notebooks — it should be a
      place you return to with things worth keeping, not a stream you chase.
    </p>
  </article>

  <!-- ░░ Meta grid ░░ -->
  <section class="mt-16 pt-8 border-t border-[color:var(--color-rule)]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">

      <div>
        <p class="eyebrow mb-3">Currently</p>
        <dl class="space-y-3 text-sm">
          <div class="grid grid-cols-[auto_1fr] gap-4 items-baseline">
            <dt class="mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Desk</dt>
            <dd class="font-serif">{NOW.location}</dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-4 items-baseline">
            <dt class="mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">Reading</dt>
            <dd class="font-serif italic">
              {NOW.book.url ? (
                <a
                  href={NOW.book.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[color:var(--color-accent)] transition-colors"
                >
                  {NOW.book.title}
                </a>
              ) : (
                NOW.book.title
              )}
            </dd>
          </div>
        </dl>
      </div>

      <div>
        <p class="eyebrow mb-3">Elsewhere</p>
        <ul class="space-y-2 mono text-xs uppercase tracking-widest">
          <li>
            <a href={SITE.github} class="hover:text-[color:var(--color-accent)] transition-colors">
              → GitHub
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="hover:text-[color:var(--color-accent)] transition-colors">
              → Email
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="hover:text-[color:var(--color-accent)] transition-colors">
              → RSS
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-3">Colophon</p>
        <p class="text-sm text-[color:var(--color-muted)] leading-relaxed font-serif">
          Built with <a href="https://astro.build" class="text-[color:var(--color-ink)] underline underline-offset-4 decoration-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] transition-colors">Astro</a> and
          <a href="https://tailwindcss.com" class="text-[color:var(--color-ink)] underline underline-offset-4 decoration-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] transition-colors">Tailwind</a>.
          Type is
          <a href="https://fonts.google.com/specimen/Fraunces" class="text-[color:var(--color-ink)] underline underline-offset-4 decoration-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] transition-colors">Fraunces</a>
          and
          <a href="https://fonts.google.com/specimen/JetBrains+Mono" class="text-[color:var(--color-ink)] underline underline-offset-4 decoration-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] transition-colors">JetBrains Mono</a>.
          Hosted on Vercel, version-controlled on GitHub.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>
