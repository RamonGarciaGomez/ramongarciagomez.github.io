---
import { SITE } from "../config";
const year = new Date().getFullYear();
---
<footer class="border-t border-[color:var(--color-rule)] mt-24">
  <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3 px-6 py-6 mono text-xs uppercase tracking-widest text-[color:var(--color-muted)]">
    <span>© {year} {SITE.author}</span>
    <div class="flex gap-6">
      <a class="hover:text-[color:var(--color-ink)] transition-colors" href={SITE.github}>GitHub</a>
      <a class="hover:text-[color:var(--color-ink)] transition-colors" href={`mailto:${SITE.email}`}>Email</a>
      <a class="hover:text-[color:var(--color-ink)] transition-colors" href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>
