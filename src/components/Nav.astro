---
import { SITE } from "../config";
const { pathname } = Astro.url;
const isActive = (href: string) =>
  pathname === href || (href !== "/" && pathname.startsWith(href));
const linkClass = (href: string) =>
  isActive(href)
    ? "text-[color:var(--color-ink)]"
    : "text-[color:var(--color-muted)] hover:text-[color:var(--color-ink)] transition-colors";
---
<header class="border-b border-[color:var(--color-rule)]">
  <nav class="max-w-5xl mx-auto flex items-center justify-between px-6 py-4">
    <a href="/" class="mono text-xs uppercase tracking-widest font-medium">
      {SITE.title}
    </a>
    <ul class="flex gap-7 mono text-xs uppercase tracking-widest">
      <li><a class={linkClass("/blog")} href="/blog">Writing</a></li>
      <li><a class={linkClass("/projects/everylotsj")} href="/projects/everylotsj">@everylotSJ</a></li>
      <li><a class={linkClass("/movement")} href="/movement">Movement</a></li>
      <li><a class={linkClass("/projects")} href="/projects">Projects</a></li>
      <li><a class={linkClass("/about")} href="/about">About</a></li>
    </ul>
  </nav>
</header>
