---
import { SITE } from "../config";
const { pathname } = Astro.url;
const link = (href: string) =>
  pathname === href || (href !== "/" && pathname.startsWith(href))
    ? "text-[color:var(--color-ink)]"
    : "text-[color:var(--color-muted)] hover:text-[color:var(--color-ink)]";
---
<header class="border-b border-[color:var(--color-rule)]">
  <nav class="max-w-3xl mx-auto flex items-center justify-between px-6 py-5">
    <a href="/" class="font-semibold tracking-tight">{SITE.title}</a>
    <ul class="flex gap-6 text-sm">
      <li><a class={link("/blog")} href="/blog">Blog</a></li>
      <li><a class={link("/projects")} href="/projects">Projects</a></li>
      <li><a class={link("/about")} href="/about">About</a></li>
    </ul>
  </nav>
</header>
